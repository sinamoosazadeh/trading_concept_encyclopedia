{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sinamoosazadeh/trading_concept_encyclopedia/schema/source-registry.schema.json",
  "title": "Source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "notes"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "sources": {
      "type": "array",
      "items": { "type": "object" }
    },
    "notes": { "type": "string" }
  }
}
