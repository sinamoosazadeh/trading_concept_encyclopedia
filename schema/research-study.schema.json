{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sinamoosazadeh/trading_concept_encyclopedia/schema/research-study.schema.json",
  "title": "Empirical research study record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "title", "study_status", "study_type", "hypothesis",
    "scope", "protocol", "data", "evaluation", "bias_review", "results",
    "reproducibility", "limitations", "related_concept_ids", "source_ids", "change_log"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 120 },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "study_status": { "type": "string", "enum": ["proposal", "preregistered", "in_progress", "completed", "replication", "superseded", "withdrawn"] },
    "study_type": { "type": "string", "enum": ["exploratory", "confirmatory", "replication", "robustness", "ablation", "execution_analysis", "other"] },
    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "null_or_counter_hypothesis", "primary_outcome", "failure_criterion"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "null_or_counter_hypothesis": { "type": "string", "minLength": 1 },
        "primary_outcome": { "type": "string", "minLength": 1 },
        "failure_criterion": { "type": "string", "minLength": 1 },
        "preregistered_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["market", "venue", "instruments", "timeframes", "start_date_utc", "end_date_utc"],
      "properties": {
        "market": { "type": "string", "minLength": 1 },
        "venue": { "type": ["string", "null"] },
        "instruments": { "type": "array", "items": { "type": "string" } },
        "timeframes": { "type": "array", "items": { "type": "string" } },
        "start_date_utc": { "type": ["string", "null"], "format": "date-time" },
        "end_date_utc": { "type": ["string", "null"], "format": "date-time" },
        "universe_selection_rule": { "type": "string" }
      }
    },
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "decision_timing", "signal_definition", "splitting_method", "baseline", "deviations"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "decision_timing": { "type": "string", "minLength": 1 },
        "signal_definition": { "type": "string", "minLength": 1 },
        "splitting_method": { "type": "string", "minLength": 1 },
        "baseline": { "type": "string", "minLength": 1 },
        "parameter_search": { "type": "string" },
        "cost_model": { "type": "string" },
        "deviations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ids", "snapshot_identifier", "timestamp_policy", "known_gaps", "rights_note"],
      "properties": {
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "snapshot_identifier": { "type": ["string", "null"] },
        "timestamp_policy": { "type": "string", "minLength": 1 },
        "known_gaps": { "type": "array", "items": { "type": "string" } },
        "rights_note": { "type": "string", "minLength": 1 },
        "data_hash": { "type": ["string", "null"] },
        "schema_version": { "type": ["string", "null"] }
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["metrics", "uncertainty_method", "sample_counts", "out_of_sample_policy"],
      "properties": {
        "metrics": { "type": "array", "items": { "type": "string" } },
        "uncertainty_method": { "type": "string", "minLength": 1 },
        "sample_counts": { "type": "object", "additionalProperties": { "type": ["integer", "number", "null"] } },
        "out_of_sample_policy": { "type": "string", "minLength": 1 },
        "benchmark_results": { "type": "string" },
        "aggregation_policy": { "type": "string" }
      }
    },
    "bias_review": {
      "type": "object", "additionalProperties": false,
      "required": ["look_ahead", "leakage", "survivorship", "selection", "multiple_testing", "execution_realism", "notes"],
      "properties": {
        "look_ahead": { "$ref": "#/$defs/biasCheck" },
        "leakage": { "$ref": "#/$defs/biasCheck" },
        "survivorship": { "$ref": "#/$defs/biasCheck" },
        "selection": { "$ref": "#/$defs/biasCheck" },
        "multiple_testing": { "$ref": "#/$defs/biasCheck" },
        "execution_realism": { "$ref": "#/$defs/biasCheck" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "results": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "supports_hypothesis", "metrics", "negative_findings", "claim_scope"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "supports_hypothesis": { "type": ["boolean", "null"] },
        "metrics": { "type": "object", "additionalProperties": { "type": ["number", "integer", "string", "null"] } },
        "negative_findings": { "type": "array", "items": { "type": "string" } },
        "claim_scope": { "type": "string", "minLength": 1 },
        "uncertainty": { "type": "string" }
      }
    },
    "reproducibility": {
      "type": "object", "additionalProperties": false,
      "required": ["code_revision", "environment", "command", "reproducibility_limits"],
      "properties": {
        "code_revision": { "type": ["string", "null"] },
        "environment": { "type": "string", "minLength": 1 },
        "command": { "type": ["string", "null"] },
        "configuration_reference": { "type": ["string", "null"] },
        "random_seed": { "type": ["integer", "null"] },
        "reproducibility_limits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "related_concept_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "source_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "change_log": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["date", "change", "rationale"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "change": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "biasCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "mitigation", "residual_risk"],
      "properties": {
        "status": { "type": "string", "enum": ["not_assessed", "not_applicable", "mitigated", "residual_risk", "identified"] },
        "mitigation": { "type": "string", "minLength": 1 },
        "residual_risk": { "type": "string", "minLength": 1 }
      }
    }
  }
}
